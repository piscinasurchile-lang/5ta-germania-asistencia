TELEGRAM_BOT_USERNAME=Alerta5tavillarrica_bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHAT_TITLE=Despachos Villarrica 2023
# ID numérico (-100…) o @usuario público del grupo (p. ej. @DespaVillarrica). bot:check lo resuelve con getChat y muestra el ID numérico real.
TELEGRAM_CHAT_ID=
# DRY_RUN=1 impide PUBLICAR en ntfy. NO impide que el lector confirme (consuma) actualizaciones de Telegram con getUpdates.
DRY_RUN=1
# Tema de pruebas: germania-test- + 20 o más caracteres aleatorios. Un nombre difícil de adivinar NO es autenticación (ver PROPUESTA-SERVICIO-OPERATIVO.md).
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
